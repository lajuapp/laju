generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum DeviceStatus {
  PENDING
  ACTIVE
  INACTIVE
  MIGRATING
  REVOKED
  CONTAINED
  DECOMMISSIONED
}

enum MigrationStatus {
  PREPARED
  TRANSFERRING
  VERIFYING
  COMMITTING
  COMMITTED
  FAILED
  EXPIRED
  CANCELLED
}

enum ConversationType {
  PERSONAL
  GROUP
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  ATTACHMENT
  CONTROL
  LOCATION
}

enum MessageState {
  SENT
  DELIVERED
  READ
  DELETED
  EXPIRED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum CallState {
  INITIATED
  RINGING
  CONNECTED
  ENDED
  REJECTED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  CONTAINED
  RESOLVED
  CLOSED
}

enum LocationPrecision {
  DISABLED
  COARSE
  PRECISE
}

enum AccessGrantStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

model User {
  id                  String      @id @default(uuid())
  username            String      @unique
  identityPublicKey   String?     @unique @map("identity_public_key")
  email               String?     @unique
  phoneNumber         String?     @unique @map("phone_number")
  passwordHash        String?     @map("password_hash")
  twoFactorEnabled    Boolean     @default(false) @map("two_factor_enabled")
  twoFactorPin        String?     @map("two_factor_pin")
  trustScore          Int         @default(100) @map("trust_score")
  status              UserStatus  @default(ACTIVE)
  suspendedReason     String?     @map("suspended_reason")
  suspendedAt         DateTime?   @map("suspended_at")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  devices              Device[]
  sessions             Session[]
  conversationMembers  ConversationMember[]
  messages             Message[]
  callParticipants     CallParticipant[]
  securityEvents       SecurityEvent[]
  locations            Location[]
  incidentTargets      IncidentTarget[]
  migrations           DeviceMigration[]    @relation("UserMigrations")
  reportsMade          UserReport[]         @relation("ReporterUser")
  reportsReceived      UserReport[]         @relation("ReportedUser")
  statusStories        UserStatusStory[]
  statusStoryViews     StatusStoryView[]
  messageReactions     MessageReaction[]

  @@map("users")
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String   // phone number or email address
  code       String
  type       String   @default("LOGIN") // LOGIN, REGISTER, RECOVERY
  expiresAt  DateTime @map("expires_at")
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, code])
  @@map("otp_codes")
}

model Device {
  id                String       @id @default(uuid())
  userId            String       @map("user_id")
  name              String?
  deviceUuid        String       @unique @map("device_uuid")
  devicePublicKey   String?      @map("device_public_key")
  platform          String?
  deviceModel       String?      @map("device_model")
  osVersion         String?      @map("os_version")
  appVersion        String?      @map("app_version")
  registrationLocation String?   @map("registration_location")
  registrationIp    String?      @map("registration_ip")
  pushToken         String?      @map("push_token")
  attestationData   String?      @map("attestation_data")
  status            DeviceStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at")
  lastSeenAt        DateTime?    @map("last_seen_at")
  revokedAt         DateTime?    @map("revoked_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceKeys        DeviceKey[]
  preKeys           PreKey[]
  sessions          Session[]
  messages          Message[]
  messageDeliveries MessageDelivery[]
  pushDevices       PushDevice[]
  securityEvents    SecurityEvent[]
  sourceMigrations  DeviceMigration[]  @relation("SourceMigrations")
  targetMigrations  DeviceMigration[]  @relation("TargetMigrations")

  @@map("devices")
}

model DeviceMigration {
  id                 String          @id @default(uuid())
  identityId         String          @map("identity_id")
  sourceDeviceId     String          @map("source_device_id")
  targetDeviceId     String?         @map("target_device_id")
  status             MigrationStatus @default(PREPARED)
  challenge          String
  sourceEphemeralKey String          @map("source_ephemeral_key")
  targetEphemeralKey String?         @map("target_ephemeral_key")
  sasCode            String?         @map("sas_code")
  failureReason      String?         @map("failure_reason")
  expiresAt          DateTime        @map("expires_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  committedAt        DateTime?       @map("committed_at")

  identity           User            @relation("UserMigrations", fields: [identityId], references: [id], onDelete: Cascade)
  sourceDevice       Device          @relation("SourceMigrations", fields: [sourceDeviceId], references: [id], onDelete: Cascade)
  targetDevice       Device?         @relation("TargetMigrations", fields: [targetDeviceId], references: [id], onDelete: SetNull)

  @@map("device_migrations")
}


model DeviceKey {
  id           String   @id @default(uuid())
  deviceId     String   @map("device_id")
  identityKey  String   @map("identity_key")
  createdAt    DateTime @default(now()) @map("created_at")
  rotatedAt    DateTime? @map("rotated_at")

  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_keys")
}

model PreKey {
  id           String   @id @default(uuid())
  deviceId     String   @map("device_id")
  keyId        Int      @map("key_id")
  publicKey    String   @map("public_key")
  signature    String?
  isOneTime    Boolean  @default(false) @map("is_one_time")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime @default(now()) @map("created_at")

  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId, isOneTime])
  @@map("pre_keys")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  deviceId     String   @map("device_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Conversation {
  id           String           @id @default(uuid())
  type         ConversationType
  title        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  members            ConversationMember[]
  messages           Message[]
  conversationEvents ConversationEvent[]
  accessGrants       ConversationAccessGrant[]

  @@map("conversations")
}

model ConversationMember {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  userId         String           @map("user_id")
  role           ConversationRole @default(MEMBER)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  leftAt         DateTime?        @map("left_at")

  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id              String       @id @default(uuid())
  conversationId  String       @map("conversation_id")
  senderUserId    String       @map("sender_user_id")
  senderDeviceId  String       @map("sender_device_id")
  clientMessageId String       @map("client_message_id")
  sequence        Int          @default(autoincrement())
  ciphertext      String
  nonce           String
  messageType     MessageType  @default(TEXT) @map("message_type")
  state           MessageState @default(SENT)
  createdAt       DateTime     @default(now()) @map("created_at")
  deletedAt       DateTime?    @map("deleted_at")
  expiresAt       DateTime?    @map("expires_at")

  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUser      User              @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  senderDevice    Device            @relation(fields: [senderDeviceId], references: [id], onDelete: Cascade)
  deliveries      MessageDelivery[]
  attachments     Attachment[]
  reactions       MessageReaction[]

  @@unique([senderDeviceId, clientMessageId])
  @@index([conversationId, sequence])
  @@map("messages")
}

model MessageDelivery {
  id          String       @id @default(uuid())
  messageId   String       @map("message_id")
  deviceId    String       @map("device_id")
  status      MessageState @default(DELIVERED)
  deliveredAt DateTime     @default(now()) @map("delivered_at")
  readAt      DateTime?    @map("read_at")

  message     Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  device      Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([messageId, deviceId])
  @@map("message_deliveries")
}

model ConversationEvent {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  eventType      String       @map("event_type")
  payload        String
  sequence       Int          @default(autoincrement())
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sequence])
  @@map("conversation_events")
}

model Attachment {
  id           String   @id @default(uuid())
  messageId    String   @map("message_id")
  blobId       String   @map("blob_id")
  mimeType     String   @map("mime_type")
  fileSize     BigInt   @map("file_size")
  checksum     String
  createdAt    DateTime @default(now()) @map("created_at")

  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("attachments")
}

model PushDevice {
  id           String   @id @default(uuid())
  deviceId     String   @map("device_id")
  clientToken  String   @map("client_token")
  endpoint     String
  createdAt    DateTime @default(now()) @map("created_at")

  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, endpoint])
  @@map("push_devices")
}

model SecurityEvent {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  deviceId     String?  @map("device_id")
  eventType    String   @map("event_type")
  severity     IncidentSeverity @default(LOW)
  details      String
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  device       Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@map("security_events")
}

model OutboxEvent {
  id             String       @id @default(uuid())
  aggregateType  String       @map("aggregate_type")
  aggregateId    String       @map("aggregate_id")
  eventType      String       @map("event_type")
  payload        String
  status         OutboxStatus @default(PENDING)
  retryCount     Int          @default(0) @map("retry_count")
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at")
  processedAt    DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_events")
}

model Call {
  id           String    @id @default(uuid())
  initiatorId  String    @map("initiator_id")
  state        CallState @default(INITIATED)
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")

  participants CallParticipant[]

  @@map("calls")
}

model CallParticipant {
  id           String    @id @default(uuid())
  callId       String    @map("call_id")
  userId       String    @map("user_id")
  deviceId     String    @map("device_id")
  state        CallState @default(RINGING)
  joinedAt     DateTime? @map("joined_at")
  leftAt       DateTime? @map("left_at")

  call         Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, deviceId])
  @@map("call_participants")
}

model Incident {
  id           String           @id @default(uuid())
  title        String
  description  String
  severity     IncidentSeverity @default(MEDIUM)
  status       IncidentStatus   @default(OPEN)
  createdAt    DateTime         @default(now()) @map("created_at")
  containedAt  DateTime?        @map("contained_at")
  resolvedAt   DateTime?        @map("resolved_at")

  targets      IncidentTarget[]

  @@map("incidents")
}

model IncidentTarget {
  id           String    @id @default(uuid())
  incidentId   String    @map("incident_id")
  userId       String?   @map("user_id")
  deviceId     String?   @map("device_id")
  isContained  Boolean   @default(false) @map("is_contained")
  containedAt  DateTime? @map("contained_at")

  incident     Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("incident_targets")
}

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  permissions AdminRolePermission[]
  sessions    AdminSession[]
  users       AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String
  roleId       String        @map("role_id")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  role         AdminRole     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions     AdminSession[]

  @@map("admin_users")
}

model AdminPermission {
  id          String   @id @default(uuid())
  slug        String   @unique
  description String?

  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String          @map("role_id")
  permissionId String          @map("permission_id")

  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminSession {
  id           String     @id @default(uuid())
  adminId      String     @map("admin_id")
  roleId       String     @map("role_id")
  tokenHash    String     @unique @map("token_hash")
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  admin        AdminUser? @relation(fields: [adminId], references: [id], onDelete: Cascade)
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@map("admin_sessions")
}

model AdminAuditEvent {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    String
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("admin_audit_events")
}

model ConversationAccessGrant {
  id             String            @id @default(uuid())
  conversationId String            @map("conversation_id")
  requestedById  String            @map("requested_by_id")
  reason         String
  status         AccessGrantStatus @default(PENDING)
  expiresAt      DateTime?         @map("expires_at")
  keyReleaseRef  String?           @map("key_release_ref")
  createdAt      DateTime          @default(now()) @map("created_at")

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  approvals      ConversationAccessApproval[]

  @@map("conversation_access_grants")
}

model ConversationAccessApproval {
  id           String   @id @default(uuid())
  grantId      String   @map("grant_id")
  approvedById String   @map("approved_by_id")
  approvedAt   DateTime @default(now()) @map("approved_at")

  grant        ConversationAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@map("conversation_access_approvals")
}

model RetentionPolicy {
  id               String   @id @default(uuid())
  resourceType     String   @map("resource_type")
  retentionSeconds Int      @map("retention_seconds")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("retention_policies")
}

model Location {
  id          String            @id @default(uuid())
  userId      String            @map("user_id")
  latitude    Float
  longitude   Float
  precision   LocationPrecision @default(COARSE)
  expiresAt   DateTime          @map("expires_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("locations")
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportCategory {
  SPAM
  SCAM
  HARASSMENT
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  OTHER
}

model UserReport {
  id              String         @id @default(uuid())
  reporterId      String         @map("reporter_id")
  reportedUserId  String         @map("reported_user_id")
  category        ReportCategory
  reason          String
  scoreDeduction  Int            @default(10) @map("score_deduction")
  status          ReportStatus   @default(PENDING)
  reviewNotes     String?        @map("review_notes")
  reviewedAt      DateTime?      @map("reviewed_at")
  reviewedBy      String?        @map("reviewed_by")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  reporter        User           @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser    User           @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([status])
  @@map("user_reports")
}

enum StatusType {
  TEXT
  IMAGE
  VIDEO
}

model UserStatusStory {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  type            StatusType     @default(TEXT)
  content         String         // text body or image/media URL or base64
  caption         String?
  backgroundColor String?        @map("background_color")
  fontStyle       String?        @map("font_style")
  createdAt       DateTime       @default(now()) @map("created_at")
  expiresAt       DateTime       @map("expires_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  views           StatusStoryView[]

  @@index([userId, expiresAt])
  @@map("user_status_stories")
}

model StatusStoryView {
  id        String          @id @default(uuid())
  storyId   String          @map("story_id")
  viewerId  String          @map("viewer_id")
  reaction  String?
  viewedAt  DateTime        @default(now()) @map("viewed_at")

  story     UserStatusStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User            @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("status_story_views")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model ChatWallpaper {
  id           String   @id @default(uuid())
  name         String
  category     String   @default("IMAGE") // SOLID, GRADIENT, PATTERN, IMAGE
  colorHex     String?  @map("color_hex")
  imageUrl     String?  @map("image_url")
  thumbnailUrl String?  @map("thumbnail_url")
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("chat_wallpapers")
}

model StickerPack {
  id          String        @id @default(uuid())
  name        String
  description String?
  publisher   String?
  coverUrl    String?       @map("cover_url")
  isActive    Boolean       @default(true) @map("is_active")
  sortOrder   Int           @default(0) @map("sort_order")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  stickers    StickerItem[]

  @@map("sticker_packs")
}

model StickerItem {
  id        String      @id @default(uuid())
  packId    String      @map("pack_id")
  name      String
  imageUrl  String      @map("image_url")
  emoji     String?
  createdAt DateTime    @default(now()) @map("created_at")

  pack      StickerPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@map("sticker_items")
}

model SystemAnnouncement {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO") // INFO, WARNING, MAINTENANCE
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_announcements")
}

model AppSystemConfig {
  id                   String   @id @default("global")
  minAndroidVersion    String   @default("1.0.0") @map("min_android_version")
  latestAndroidVersion String   @default("1.0.0") @map("latest_android_version")
  forceUpdate          Boolean  @default(false) @map("force_update")
  maintenanceMode      Boolean  @default(false) @map("maintenance_mode")
  maintenanceMessage   String?  @map("maintenance_message")
  apkUrl               String?  @map("apk_url")
  apkFilename          String?  @map("apk_filename")
  apkSize              Int?     @map("apk_size")
  apkSha256            String?  @map("apk_sha256")
  releaseNotes         String?  @map("release_notes")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("app_system_configs")
}

