# Database (PostgreSQL)
POSTGRES_DB=secure_messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_123
DATABASE_URL=postgresql://postgres:postgres_secure_pass_123@postgres:5432/secure_messenger?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Gotify
GOTIFY_URL=http://gotify:80
GOTIFY_CLIENT_TOKEN=dummy_gotify_token_dev

# SeaweedFS
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888

# Application Secrets
JWT_SECRET=super_secret_jwt_key_min_32_chars_long_12345
JWT_EXPIRES_IN=7d
ADMIN_SESSION_SECRET=admin_session_secret_change_in_production_12345

# Port
PORT=3000
NODE_ENV=development
